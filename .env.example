# Synthetic Data Agent local/runtime configuration
# Copy this file to .env and fill in values for your environment.
# Linux/macOS: set -a && source .env && set +a
# Windows PowerShell: set these values with $env:NAME = "value"

SDA_METADATA_RUNTIME=databricks_sql
SDA_CATALOG_ALLOWLIST=main
SDA_SCHEMA_ALLOWLIST=sales
SDA_TABLE_PATTERNS=customers*,orders
SDA_MAX_METADATA_OBJECTS=100

# Databricks SQL Warehouse connection settings.
# DATABRICKS_HOST may include or omit https://; the app normalizes it.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=<token>
